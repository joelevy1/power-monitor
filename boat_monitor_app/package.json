{
  "name": "boat-monitor-app",
  "version": "0.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "validate": "(npx expo-doctor@latest || true) && npm run validate:bundle",
    "validate:bundle": "EXPO_PUBLIC_APP_VARIANT=full expo export --platform ios --output-dir /tmp/boat-monitor-export-full && EXPO_PUBLIC_APP_VARIANT=smoke expo export --platform ios --output-dir /tmp/boat-monitor-export-smoke",
    "eas:ios": "eas build --platform ios --profile preview --non-interactive",
    "eas:ios:prod": "eas build --platform ios --profile production --non-interactive --auto-submit --no-wait",
    "eas:ios:next": "eas build --platform ios --profile production_xcode26 --non-interactive --auto-submit --no-wait",
    "eas:submit:ios": "eas submit --platform ios --latest --profile production --non-interactive",
    "eas:submit:ios:next": "eas submit --platform ios --latest --profile production_xcode26 --non-interactive",
    "eas-build-post-install": "bash scripts/configure-google-maps-ios.sh",
    "android": "expo run:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "base64-js": "^1.5.1",
    "expo": "~50.0.0",
    "expo-build-properties": "~0.11.1",
    "expo-constants": "~15.4.6",
    "expo-font": "~11.10.3",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-ble-plx": "^3.5.1",
    "react-native-maps": "1.10.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "~7.9.2"
  },
  "engines": {
    "node": ">=18 <=24"
  }
}
