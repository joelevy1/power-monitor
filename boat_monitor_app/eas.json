{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "smoke": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "smoke"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "full"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "full"
      },
      "prebuildCommand": "bash scripts/configure-google-maps-ios.sh",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    },
    "production_xcode26": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "full"
      },
      "prebuildCommand": "bash scripts/configure-google-maps-ios.sh",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    }
  },
  "submit": {
    "smoke": {
      "ios": {
        "ascAppId": "6797728128"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6797728128"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6797728128"
      }
    },
    "production_xcode26": {
      "ios": {
        "ascAppId": "6797728128"
      }
    }
  }
}
